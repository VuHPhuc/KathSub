{
  "name": "kathsub",
  "version": "1.3.0",
  "description": "KathSub - Trình chỉnh sửa phụ đề video / Video Subtitle Editor",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"Vite,Electron\" -c \"cyan,yellow\" \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "electron-updater": "^6.1.8",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "onnxruntime-node": "^1.21.0",
    "openai": "^4.52.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kathsub.app",
    "productName": "KathSub",
    "publish": [
      {
        "provider": "github",
        "owner": "VuHPhuc",
        "repo": "KathSub"
      }
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
